{
  "productName": "Clawcage",
  "version": "0.8.8",
  "identifier": "com.clawcage.clawcage",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clawcage",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../assets/vmlinuz": "vmlinuz",
      "../../assets/initrd.img": "initrd.img",
      "../../assets/rootfs.squashfs": "rootfs.squashfs",
      "../../assets/B3SUMS": "B3SUMS"
    },
    "macOS": {
      "entitlements": "../../entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RTIxOTI5RDUxRkU3NDIKUldSQzV4L1ZLUm5pbGhrdVQ2Y0dhbE11NlJPSlNRTzBrWVpFUkV1VkFuZEgyNjVza2lSNWV2S3QK",
      "endpoints": [
        "https://github.com/google/clawcage/releases/latest/download/latest.json"
      ]
    }
  }
}
