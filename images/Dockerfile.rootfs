# Build a populated rootfs for the clawcage VM.
# Contains developer tools, runtimes, and AI coding CLIs.
# Mounted read-only at boot; only /root is writable (tmpfs).

FROM --platform=linux/arm64 debian:bookworm-slim

# Core utilities and inspection tools (see apt-packages.txt to add/remove packages)
# apt-get upgrade pulls latest security patches and package versions at build time.
COPY apt-packages.txt /tmp/apt-packages.txt
RUN apt-get update && \
    apt-get upgrade -y && \
    grep -v '^\s*#' /tmp/apt-packages.txt | grep -v '^\s*$' | \
    xargs apt-get install -y --no-install-recommends && \
    ln -sf vim.tiny /usr/bin/vim && \
    pip3 install --break-system-packages --upgrade pip && \
    rm /tmp/apt-packages.txt

# Node.js 24 LTS via nvm (Debian bookworm ships v18 which lacks the 'v'
# regex flag needed by modern npm packages like @google/gemini-cli).
# nvm install script always fetches latest release. npm upgraded to latest after.
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p $NVM_DIR && \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash && \
    bash -c '. $NVM_DIR/nvm.sh && nvm install 24 && npm install -g npm@latest && \
    for bin in node npm npx; do ln -sf "$(which $bin)" /usr/local/bin/$bin; done'

# uv -- fast Python package installer (also available to guest AI agents)
RUN curl -LsSf https://astral.sh/uv/install.sh | env INSTALLER_NO_MODIFY_PATH=1 sh && \
    install -m 555 /root/.local/bin/uv /usr/local/bin/uv && \
    install -m 555 /root/.local/bin/uvx /usr/local/bin/uvx

# Claude Code -- download binary directly using the URL from the official install script.
# Extracts the GCS bucket and latest version from install.sh so we don't depend on
# the installer's HOME layout. Binary goes straight to /usr/local/bin/claude.
RUN GCS_BUCKET=$(curl -fsSL https://claude.ai/install.sh | grep 'GCS_BUCKET=' | head -1 | cut -d'"' -f2) && \
    VERSION=$(curl -fsSL "$GCS_BUCKET/latest") && \
    curl -fsSL "$GCS_BUCKET/$VERSION/linux-arm64/claude" -o /usr/local/bin/claude && \
    chmod 755 /usr/local/bin/claude

# Other AI coding CLIs -- installed to /opt/ai-clis (staging area).
# Copied to writable scratch disk at boot by clawcage-init so that
# auto-update works (CLIs self-update and need writable node_modules).
COPY npm-globals.txt /tmp/npm-globals.txt
RUN grep -v '^\s*#' /tmp/npm-globals.txt | grep -v '^\s*$' | \
    xargs npm install -g --prefix /opt/ai-clis && \
    npm cache clean --force && \
    rm /tmp/npm-globals.txt

# Install MITM CA certificate into system trust store
# (copied into images/ by build.py before docker build)
COPY clawcage-ca.crt /usr/local/share/ca-certificates/clawcage-ca.crt
RUN update-ca-certificates

# Patch certifi's CA bundle (Python requests/openai SDK use certifi, not system store)
RUN uv pip install --system --break-system-packages certifi && \
    CERTIFI_BUNDLE=$(python3 -c "import certifi; print(certifi.where())") && \
    cat /usr/local/share/ca-certificates/clawcage-ca.crt >> "$CERTIFI_BUNDLE"

# PTY agent binary (built externally, cross-compiled for aarch64-linux-musl)
# Bridges PTY I/O over vsock for high-performance terminal communication.
# Read-only + execute (555): prevent guest processes from modifying the agent.
COPY clawcage-pty-agent /usr/local/bin/clawcage-pty-agent
RUN chmod 555 /usr/local/bin/clawcage-pty-agent

# Net proxy binary (cross-compiled for aarch64-linux-musl)
# Bridges TCP connections from the guest to the host SNI proxy via vsock.
COPY clawcage-net-proxy /usr/local/bin/clawcage-net-proxy
RUN chmod 555 /usr/local/bin/clawcage-net-proxy

# Shell config (sourced by clawcage-init via --rcfile)
COPY clawcage-bashrc /etc/clawcage-bashrc
COPY banner.txt /etc/clawcage-banner.txt
COPY tips.txt /etc/clawcage-tips.txt

# Common Python packages (pre-installed so they're available immediately).
# The boot-time venv uses --system-site-packages to inherit these.
# Agents can still pip/uv install additional packages into the venv.
COPY requirements.txt /tmp/requirements.txt
RUN uv pip install --system --break-system-packages -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Diagnostic test suite
COPY diagnostics/ /usr/local/lib/clawcage-tests/

# Doctor script (entry point)
COPY clawcage-doctor /usr/local/bin/clawcage-doctor
RUN chmod 755 /usr/local/bin/clawcage-doctor
# Backward compat: clawcage-test -> clawcage-doctor
RUN ln -sf clawcage-doctor /usr/local/bin/clawcage-test

# Bench script (disk I/O + HTTP performance benchmarks)
COPY clawcage-bench /usr/local/bin/clawcage-bench
RUN chmod 755 /usr/local/bin/clawcage-bench

# Remove PEP 668 EXTERNALLY-MANAGED marker.
# This is an ephemeral sandboxed VM -- the protection is unnecessary and blocks
# pip install with a confusing error.  A pre-activated venv handles writes
# (since the rootfs is read-only) but removing the marker is belt-and-suspenders
# so any stray pip invocation outside the venv gives a real error, not PEP 668.
RUN rm -f /usr/lib/python*/EXTERNALLY-MANAGED

# Strip setuid/setgid bits from all binaries (VM runs as root, no need for them).
RUN find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -exec chmod u-s,g-s {} + 2>/dev/null || true

# /root is a tmpfs at runtime, so don't put anything here
RUN rm -rf /root && mkdir -p /root

# Switch apt sources to HTTPS for runtime use.
# Build uses HTTP (ca-certificates not available earlier); VM blocks port 80.
RUN sed -i 's|URIs: http://|URIs: https://|g' /etc/apt/sources.list.d/debian.sources
