#!/bin/sh
# Clawcage sandbox init script.
# Replaces /init in the initramfs.
# Mounts squashfs rootfs from /dev/vda, stacks overlayfs (immutable lower
# + ephemeral tmpfs upper), then chroot into the real root.

# Mount essential filesystems
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts   devpts   /dev/pts

# Optimize block I/O: virtio performs best with 'none' scheduler (host OS handles it)
# and a larger read-ahead buffer.
for dev in /sys/block/vd*; do
    if [ -d "$dev" ]; then
        echo none > "$dev/queue/scheduler" 2>/dev/null || true
        echo 4096 > "$dev/queue/read_ahead_kb" 2>/dev/null || true
        echo 256 > "$dev/queue/nr_requests" 2>/dev/null || true
    fi
done

# Load kernel modules listed in /conf/modules (populated by initramfs-tools)
if [ -f /conf/modules ]; then
    while read -r mod args; do
        case "$mod" in \#*|"") continue ;; esac
        modprobe -q "$mod" $args 2>/dev/null || true
    done < /conf/modules
fi

# IMPORTANT: Wait for hardware to enumerate (including virtio_console/hvc0).
# Redirecting to /dev/console before this will fail and crash the init script.
sleep 1

# Send all output to console so we can see what happens
exec 0</dev/console 1>/dev/console 2>/dev/console

echo "[clawcage-init] listing block devices..."
ls /dev/vda* 2>&1 || echo "[clawcage-init] no /dev/vda found"

# Mount squashfs (immutable lower layer)
mkdir -p /mnt/a
echo "[clawcage-init] mounting /dev/vda (squashfs)..."
mount -t squashfs /dev/vda /mnt/a
echo "[clawcage-init] mount exit: $?"

echo "[clawcage-init] checking /mnt/a/bin/bash..."
ls /mnt/a/bin/bash 2>&1

# Create tmpfs for overlay upper + workdir.
# INVARIANT: upperdir MUST be tmpfs -- never the initramfs or scratch disk.
# A non-tmpfs upper layer would allow writes to persist across reboots.
# If this mount fails, abort loudly rather than silently boot degraded.
mkdir -p /mnt/b
mount -t tmpfs tmpfs /mnt/b || {
    echo "[clawcage-init] FATAL: cannot mount tmpfs on /mnt/b -- aborting"
    exit 1
}
mkdir -p /mnt/b/u /mnt/b/w

# Stack overlayfs: squashfs (read-only lower) + tmpfs (ephemeral upper).
# redirect_dir=on enables directory renames via xattr redirects (required for dpkg/apt).
# metacopy=on defers data copies until writes occur (speeds up layer transitions).
# Fall back to plain overlayfs if the kernel lacks redirect_dir support.
# Either way, both attempts use /mnt/b/u (tmpfs) as upperdir -- never degrade further.
mkdir -p /newroot
mount -t overlay overlay \
  -o lowerdir=/mnt/a,upperdir=/mnt/b/u,workdir=/mnt/b/w,redirect_dir=on,metacopy=on \
  /newroot || \
mount -t overlay overlay \
  -o lowerdir=/mnt/a,upperdir=/mnt/b/u,workdir=/mnt/b/w \
  /newroot || {
    echo "[clawcage-init] FATAL: overlayfs mount failed -- aborting"
    exit 1
}

# Mount virtual filesystems fresh in the new root.
# /proc, /sys, /dev exist as empty dirs from docker export.
# /dev/pts is created after devtmpfs is mounted (devtmpfs is writable).
mount -t proc     proc     /newroot/proc
mount -t sysfs    sysfs    /newroot/sys
mount -t devtmpfs devtmpfs /newroot/dev
mkdir -p /newroot/dev/pts
mount -t devpts   devpts   /newroot/dev/pts

# Mount /root: prefer scratch disk (virtio block device), fall back to tmpfs.
# The scratch disk provides ~8GB of workspace instead of RAM-limited tmpfs.
# Must happen AFTER /newroot/dev is mounted so device nodes resolve in chroot.
# Uses rootfs e2fsprogs (not busybox) for ext4 support.
SCRATCH=""
if [ -b /dev/vdb ]; then
    SCRATCH=/dev/vdb
fi

if [ -n "$SCRATCH" ]; then
    # Check if the scratch disk already has a filesystem (persistent venv).
    # If it does, mount it directly without formatting.
    # NOTE: blkid is NOT in the initramfs -- use the rootfs copy via chroot.
    HAS_FS=0
    if chroot /newroot blkid "$SCRATCH" >/dev/null 2>&1; then
        HAS_FS=1
    fi

    if [ "$HAS_FS" = "1" ]; then
        echo "[clawcage-init] existing filesystem detected on scratch disk, mounting..."
        if mount -t ext4 -o rw,noatime,nodiratime "$SCRATCH" /newroot/root; then
            echo "[clawcage-init] /root mounted from persistent scratch disk"
            # Enable swap if it exists from a previous boot.
            if [ -f /newroot/root/.swapfile ]; then
                swapon /newroot/root/.swapfile 2>/dev/null
                echo "[clawcage-init] swap enabled (existing)"
            fi
        else
            echo "[clawcage-init] WARNING: persistent scratch disk mount failed, formatting..."
            HAS_FS=0
        fi
    fi

    if [ "$HAS_FS" = "0" ]; then
        echo "[clawcage-init] formatting scratch disk ($SCRATCH)..."
        if chroot /newroot /usr/sbin/mke2fs -t ext4 -m 0 -O ^has_journal -E lazy_itable_init=1 -L scratch -q "$SCRATCH" 2>&1; then
            if mount -t ext4 -o rw,noatime,nodiratime "$SCRATCH" /newroot/root; then
                echo "[clawcage-init] /root mounted from scratch disk"
                # Create a 1GB swap file on the scratch disk.
                dd if=/dev/zero of=/newroot/root/.swapfile bs=1M count=1024 2>/dev/null
                chmod 600 /newroot/root/.swapfile
                mkswap /newroot/root/.swapfile >/dev/null 2>&1
                swapon /newroot/root/.swapfile
                echo "[clawcage-init] swap enabled (1GB)"
            else
                echo "[clawcage-init] WARNING: scratch disk mount failed, falling back to tmpfs"
                mount -t tmpfs tmpfs /newroot/root
            fi
        else
            echo "[clawcage-init] WARNING: scratch disk format failed, falling back to tmpfs"
            mount -t tmpfs tmpfs /newroot/root
        fi
    fi
else
    mount -t tmpfs tmpfs /newroot/root
    echo "[clawcage-init] /root mounted as tmpfs (no scratch disk)"
fi

# Remove legacy HTTP sources.list if present (belt-and-suspenders).
# The rootfs already has HTTPS-only debian.sources from the Docker build.
rm -f /newroot/etc/apt/sources.list

# dpkg: skip fsync/atomic-rename; overlayfs redirect_dir handles consistency.
mkdir -p /newroot/etc/dpkg/dpkg.cfg.d
echo "force-unsafe-io" > /newroot/etc/dpkg/dpkg.cfg.d/force-unsafe-io

# === Network: air-gapped IP stack ===
# The guest has no real NIC. We create a dummy interface with a local IP,
# run a fake DNS that resolves everything to that IP, and use iptables to
# redirect port 443 to our vsock-backed proxy. The host SNI proxy then
# inspects TLS ClientHello for the domain and bridges to the real server.
echo "[clawcage-init] setting up network..."
chroot /newroot ip link set lo up 2>/dev/null || true
chroot /newroot ip link add dummy0 type dummy
chroot /newroot ip addr add 10.0.0.1/24 dev dummy0
chroot /newroot ip link set dummy0 up
chroot /newroot ip route add default dev dummy0

# Fake DNS: all domains resolve to 10.0.0.1.
# Bind-mount resolv.conf from /run to ensure dnsmasq config takes effect.
echo "nameserver 127.0.0.1" > /newroot/run/resolv.conf
mount --bind /newroot/run/resolv.conf /newroot/etc/resolv.conf
chroot /newroot dnsmasq --no-daemon --no-resolv --no-hosts \
    --address=/#/10.0.0.1 --listen-address=127.0.0.1 --port=53 &
sleep 0.2

# iptables REDIRECT: use iptables-legacy since kernel has NF_TABLES=n.
IPTABLES=iptables
if [ -x /newroot/usr/sbin/iptables-legacy ]; then
    IPTABLES=iptables-legacy
fi
chroot /newroot "$IPTABLES" -t nat -A OUTPUT -p tcp --dport 443 -j REDIRECT --to-port 10443
echo "[clawcage-init] network ready"

# Launch net proxy (TCP->vsock bridge) as background process.
# Prefer initrd-bundled copy, fall back to rootfs.
NET_PROXY_PATH=""
if [ -x /clawcage-net-proxy ]; then
    cp /clawcage-net-proxy /newroot/run/clawcage-net-proxy
    chmod 555 /newroot/run/clawcage-net-proxy
    NET_PROXY_PATH=/run/clawcage-net-proxy
elif [ -x /newroot/usr/local/bin/clawcage-net-proxy ]; then
    NET_PROXY_PATH=/usr/local/bin/clawcage-net-proxy
fi
if [ -n "$NET_PROXY_PATH" ]; then
    chroot /newroot "$NET_PROXY_PATH" &
    sleep 0.1
    echo "[clawcage-init] net-proxy started"
else
    echo "[clawcage-init] WARNING: clawcage-net-proxy not found, no HTTPS proxy"
fi

# Deploy MCP server binary (stdio-to-vsock relay for AI agents).
# Prefer initrd-bundled copy, fall back to rootfs.
if [ -x /clawcage-mcp-server ]; then
    cp /clawcage-mcp-server /newroot/run/clawcage-mcp-server
    chmod 555 /newroot/run/clawcage-mcp-server
    echo "[clawcage-init] mcp-server deployed"
elif [ -x /newroot/usr/local/bin/clawcage-mcp-server ]; then
    cp /newroot/usr/local/bin/clawcage-mcp-server /newroot/run/clawcage-mcp-server
    chmod 555 /newroot/run/clawcage-mcp-server
    echo "[clawcage-init] mcp-server deployed (from rootfs)"
fi

# Raise inotify watch limit for filesystem watcher.
echo 65536 > /proc/sys/fs/inotify/max_user_watches 2>/dev/null || true

# Launch filesystem watcher (inotify->vsock bridge) as background process.
# Prefer initrd-bundled copy, fall back to rootfs.
FS_WATCH_PATH=""
if [ -x /clawcage-fs-watch ]; then
    cp /clawcage-fs-watch /newroot/run/clawcage-fs-watch
    chmod 555 /newroot/run/clawcage-fs-watch
    FS_WATCH_PATH=/run/clawcage-fs-watch
elif [ -x /newroot/usr/local/bin/clawcage-fs-watch ]; then
    FS_WATCH_PATH=/usr/local/bin/clawcage-fs-watch
fi
if [ -n "$FS_WATCH_PATH" ]; then
    chroot /newroot "$FS_WATCH_PATH" &
    sleep 0.1
    echo "[clawcage-init] fs-watch started"
else
    echo "[clawcage-init] WARNING: clawcage-fs-watch not found, no file telemetry"
fi

# Launch port watcher (proc/net/tcp->vsock bridge) as background process.
# Prefer initrd-bundled copy, fall back to rootfs.
PORT_WATCH_PATH=""
if [ -x /clawcage-port-watch ]; then
    cp /clawcage-port-watch /newroot/run/clawcage-port-watch
    chmod 555 /newroot/run/clawcage-port-watch
    PORT_WATCH_PATH=/run/clawcage-port-watch
elif [ -x /newroot/usr/local/bin/clawcage-port-watch ]; then
    PORT_WATCH_PATH=/usr/local/bin/clawcage-port-watch
fi
if [ -n "$PORT_WATCH_PATH" ]; then
    chroot /newroot "$PORT_WATCH_PATH" &
    sleep 0.1
    echo "[clawcage-init] port-watch started"
else
    echo "[clawcage-init] WARNING: clawcage-port-watch not found, no port telemetry"
fi

# Launch system metrics watcher (CPU/mem/disk->vsock bridge) as background process.
# Prefer initrd-bundled copy, fall back to rootfs.
SYS_WATCH_PATH=""
if [ -x /clawcage-sys-watch ]; then
    cp /clawcage-sys-watch /newroot/run/clawcage-sys-watch
    chmod 555 /newroot/run/clawcage-sys-watch
    SYS_WATCH_PATH=/run/clawcage-sys-watch
elif [ -x /newroot/usr/local/bin/clawcage-sys-watch ]; then
    SYS_WATCH_PATH=/usr/local/bin/clawcage-sys-watch
fi
if [ -n "$SYS_WATCH_PATH" ]; then
    chroot /newroot "$SYS_WATCH_PATH" &
    sleep 0.1
    echo "[clawcage-init] sys-watch started"
else
    echo "[clawcage-init] WARNING: clawcage-sys-watch not found, no system metrics"
fi

# Deploy initrd-bundled clawcage-doctor and diagnostics (fast iteration).
# Overwrites rootfs copies via the overlayfs upper layer.
if [ -x /clawcage-doctor ]; then
    cp /clawcage-doctor /newroot/usr/local/bin/clawcage-doctor
    chmod 755 /newroot/usr/local/bin/clawcage-doctor
    echo "[clawcage-init] clawcage-doctor deployed"
fi
if [ -x /clawcage-bench ]; then
    cp /clawcage-bench /newroot/usr/local/bin/clawcage-bench
    chmod 755 /newroot/usr/local/bin/clawcage-bench
    echo "[clawcage-init] clawcage-bench deployed"
fi
if [ -d /diagnostics ]; then
    mkdir -p /newroot/usr/local/lib/clawcage-tests
    cp -a /diagnostics/* /newroot/usr/local/lib/clawcage-tests/
    echo "[clawcage-init] diagnostics deployed"
fi

# Increase open file descriptor limit to prevent EMFILE/Errno 24 crashes
ulimit -n 65536

# Set up environment (clawcage-init defaults; the PTY agent overrides these
# with values from the host's BootConfig message at vsock handshake time).
export TERM=xterm-256color
export COLORTERM=truecolor
export HOME=/root
export PATH=/root/.npm-global/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C

# Signal to AI CLIs that we are inside a sandbox (allows root + bypass permissions).
export IS_SANDBOX=1

# Optimize Node.js and Python for the sandboxed VM environment
# 1. Prevent kernel OOMs by capping Node's V8 heap (VM has 4GB RAM by default)
export NODE_OPTIONS="--max-old-space-size=2048"
# 2. Disable slow network checks and ads during CLI executions
export NO_UPDATE_NOTIFIER=1
export NPM_CONFIG_UPDATE_NOTIFIER=false
export NPM_CONFIG_FUND=false
export NPM_CONFIG_AUDIT=false
export PIP_DISABLE_PIP_VERSION_CHECK=1

# Create Python virtualenv so pip/uv installs go to the scratch disk.
# --system-site-packages: inherit pre-installed packages (numpy, requests, etc.)
# from the squashfs rootfs while allowing new installs into the writable venv.
# uv venv is ~100ms; fall back to stdlib venv if uv is missing.
# Skip if .venv already exists (persistent venv with data from prior boot).
if [ ! -d /newroot/root/.venv ]; then
    chroot /newroot uv venv --system-site-packages /root/.venv 2>/dev/null || \
        chroot /newroot python3 -m venv --system-site-packages /root/.venv 2>/dev/null || true
fi

# Copy AI CLIs from rootfs staging area to writable scratch disk.
# They need to be mutable because they self-update at runtime.
# Also serves as the npm global prefix so `npm install -g` works.
# Skip if .npm-global already exists (persistent venv with data from prior boot).
if [ -d /newroot/root/.npm-global ]; then
    echo "[clawcage-init] AI CLIs already on scratch disk (persistent)"
elif [ -d /newroot/opt/ai-clis ]; then
    cp -a /newroot/opt/ai-clis /newroot/root/.npm-global
    echo "[clawcage-init] AI CLIs copied to scratch disk"
else
    mkdir -p /newroot/root/.npm-global
fi
chroot /newroot npm config set prefix /root/.npm-global 2>/dev/null || true

# Deploy renamed config files into overlay (rootfs may still have old capsem-* names).
for f in clawcage-bashrc clawcage-banner.txt clawcage-tips.txt; do
    if [ -f "/$f" ]; then
        cp "/$f" "/newroot/etc/$f"
        echo "[clawcage-init] deployed /etc/$f from initrd"
    else
        echo "[clawcage-init] WARNING: /$f not found in initrd"
    fi
done

# Ensure clawcage-tests directory exists (rootfs may have old capsem-tests name).
mkdir -p /newroot/usr/local/lib/clawcage-tests

echo "[clawcage-init] about to chroot..."

# Launch the PTY agent for vsock-based terminal I/O.
# The agent creates a PTY pair, forks bash, and bridges via vsock to the host.
# This gives full terminal features (resize, job control, TUI apps) and
# high-throughput I/O without serial bottlenecks.
#
# Prefer initrd-bundled agent (injected by `just repack`) over rootfs copy.
# This allows fast agent iteration without a full rootfs rebuild.
AGENT_PATH=""
if [ -x /clawcage-pty-agent ]; then
    # Copy from initrd to writable tmpfs so chroot can access it.
    # Read-only + execute (555): prevent guest processes from modifying the agent.
    cp /clawcage-pty-agent /newroot/run/clawcage-pty-agent
    chmod 555 /newroot/run/clawcage-pty-agent
    AGENT_PATH=/run/clawcage-pty-agent
    echo "[clawcage-init] using initrd-bundled agent"
elif [ -x /newroot/usr/local/bin/clawcage-pty-agent ]; then
    AGENT_PATH=/usr/local/bin/clawcage-pty-agent
    echo "[clawcage-init] using rootfs agent"
else
    echo "[clawcage-init] FATAL: clawcage-pty-agent not found"
    echo "[clawcage-init] Rebuild with 'just build' or 'just repack'"
    # Keep PID 1 alive to prevent kernel panic, but no shell is started.
    while true; do sleep 60; done
fi

echo "[clawcage-init] starting PTY agent (vsock mode)"
chroot /newroot "$AGENT_PATH"

# If bash exits (e.g. user types 'exit'), keep PID 1 alive to prevent kernel panic.
while true; do sleep 1; done
