# Clawcage sandbox shell config

# Terminal setup (xterm.js renders in the browser)
# Note: stderr stays on the PTY (not redirected to /dev/hvc0) so that
# readline's prompt output goes through the vsock terminal path.
export TERM=xterm-256color
export LANG=C
export HISTSIZE=500
export HISTFILE=/root/.bash_history
export HOME=/root
cd /root

# Prompt: green bold "clawcage" with blue directory
PS1='\[\033[1;32m\]clawcage\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '

# Activate Python virtualenv (packages install here since rootfs is read-only).
# Created by clawcage-init at boot using uv.
if [ -f /root/.venv/bin/activate ]; then
    . /root/.venv/bin/activate
fi

# Writable bin dirs on PATH:
#   ~/.npm-global/bin  -- npm install -g (AI CLIs + user packages)
#   ~/.local/bin       -- pip install --user / uvx entry points
#   ~/.venv/bin        -- added by venv activate above
export PATH="/root/.npm-global/bin:/root/.local/bin:$PATH"

# Alias pip to uv pip (faster, no root warning, auto-detects active venv).
alias pip='uv pip'
alias pip3='uv pip'
alias python='uv run python'
alias python3='uv run python3'

# AI CLIs: auto-approve tool calls (VM is already sandboxed).
# Without --yolo, non-interactive mode (-p) hides write/execute tools.
alias gemini='gemini --yolo'

# Color aliases
alias ls='ls --color=auto'
alias ll='ls -la --color=auto'
alias grep='grep --color=auto'

# Colors: blue for positive/ready, purple for negative/disabled, dim for neutral.
_BLUE='\033[0;34m'
_PURPLE='\033[0;35m'
_DIM='\033[0;90m'
_BOLD='\033[1;37m'
_RST='\033[0m'

# One-shot template setup: if present, run BEFORE the banner.
# The start marker tells the frontend to show a "Setting up..." overlay
# and suppress all terminal output until the done marker.
_CLAWCAGE_SETUP=0
if [ -f /root/.clawcage-setup-rc ]; then
    _CLAWCAGE_SETUP=1
    printf '\033]777;clawcage-setup;start\033\\'
    printf '\033[2J\033[H'
    bash /root/.clawcage-setup-rc
    rm -f /root/.clawcage-setup-rc
    printf '\033]777;clawcage-setup;done\033\\'
fi

# Clear screen and show welcome banner
printf '\033[2J\033[H'
if [ -f /etc/clawcage-banner.txt ]; then
    sed "s/%KERNEL%/$(uname -r)/g; s/%ARCH%/$(uname -m)/g" /etc/clawcage-banner.txt | \
        while IFS= read -r line; do echo -e "${_BLUE}${line}${_RST}"; done
fi

# Show AI tool status based on policy (CLAWCAGE_*_ALLOWED) and API key env vars.
# Host injects CLAWCAGE_ANTHROPIC_ALLOWED, CLAWCAGE_OPENAI_ALLOWED, CLAWCAGE_GOOGLE_ALLOWED
# as "1" or "0" at boot based on the provider allow toggles in settings.
_ai_status() {
    local name=$1 allowed_var=$2 key_var=$3
    local allowed="${!allowed_var}"
    local has_key="${!key_var}"
    if [ "$allowed" = "1" ] && [ -n "$has_key" ]; then
        echo -e "  ${_BOLD}$name${_RST} ${_BLUE}ready${_RST}"
    elif [ "$allowed" = "1" ]; then
        echo -e "  ${_BOLD}$name${_RST} ${_PURPLE}no api key -- configure in settings${_RST}"
    elif [ "$allowed" = "0" ]; then
        echo -e "  ${_BOLD}$name${_RST} ${_PURPLE}disabled by policy${_RST}"
    fi
}
echo ""
echo -e "  ${_DIM}AI:${_RST}"
_ai_status "claude" "CLAWCAGE_ANTHROPIC_ALLOWED" "ANTHROPIC_API_KEY"
_ai_status "gemini" "CLAWCAGE_GOOGLE_ALLOWED"    "GEMINI_API_KEY"
_ai_status "codex"  "CLAWCAGE_OPENAI_ALLOWED"    "OPENAI_API_KEY"
unset -f _ai_status

# Random tip from /etc/clawcage-tips.txt
if [ -f /etc/clawcage-tips.txt ]; then
    _tips=()
    while IFS= read -r _line; do
        case "$_line" in \#*|"") continue ;; esac
        _tips+=("$_line")
    done < /etc/clawcage-tips.txt
    if [ ${#_tips[@]} -gt 0 ]; then
        echo ""
        echo -e "  ${_DIM}tip: ${_tips[RANDOM % ${#_tips[@]}]}${_RST}"
    fi
    unset _tips _line
fi

unset _BLUE _PURPLE _DIM _BOLD _RST
echo ""
ulimit -n 65536

